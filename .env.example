# Firebase Service Account JSON (optional fallback for server-side admin access if IAM/ADC is unavailable)
# Preferred production method: Cloud Run runtime service account with IAM roles (Cloud Datastore User).
# FIREBASE_SERVICE_ACCOUNT=

# Google Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Anthropic Claude API Key
ANTHROPIC_API_KEY=

# Canonical public application URL. Required in production for OAuth and Stripe redirects.
# Example: https://chartering.example.com
APP_BASE_URL=

# Number of trusted reverse-proxy hops in production (Cloud Run default: 1).
TRUST_PROXY_HOPS=1

# Maximum parsed JSON request body size (Express syntax, e.g. 1mb, 512kb).
JSON_BODY_LIMIT=1mb

# Distributed rate limiting for multi-instance production.
REDIS_ENABLED=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DISTRIBUTED_RATE_LIMIT_REQUIRED=true
DISTRIBUTED_RATE_LIMIT_FAIL_OPEN=false
MAX_AI_REQUESTS_PER_MINUTE=60

# Encrypts Gmail refresh tokens and IMAP passwords at application level.
# Generate 32 random bytes and store the base64 value as a backend secret.
EMAIL_CREDENTIALS_ENCRYPTION_KEY=

# Shared secret required by the generic inbound email webhook.
# Send it in the x-email-webhook-secret header.
EMAIL_WEBHOOK_SECRET=

# Durable email sync. Production defaults to cloud_tasks.
# Set EMAIL_SYNC_ENABLED=false only if the deployment intentionally disables IMAP sync.
EMAIL_SYNC_ENABLED=true
EMAIL_SYNC_MODE=cloud_tasks
CLOUD_TASKS_PROJECT_ID=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=
EMAIL_SYNC_WORKER_URL=
# Service account used by Cloud Tasks to mint the OIDC token for the worker.
CLOUD_TASKS_INVOKER_SERVICE_ACCOUNT=
# Optional; defaults to EMAIL_SYNC_WORKER_URL.
EMAIL_SYNC_WORKER_AUDIENCE=

# Prevent large attachments/messages from consuming worker memory or oversized Firestore docs.
EMAIL_SYNC_MAX_MESSAGE_BYTES=524288
EMAIL_SYNC_MAX_STORED_BODY_CHARS=200000

# Google OAuth Client ID (for Gmail integration)
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign-In Configuration
# Set to 'true' to enable the Apple Sign-In button on the registration screen.
# Ensure Firebase Authentication is configured with Apple Provider (Service ID, Team ID, Key ID, Private Key)
# and the app domain is authorized in both Firebase and Apple Developer Console.
VITE_APPLE_AUTH_ENABLED=false

# Stripe Settings
# Set BILLING_ENABLED=false only for deployments that intentionally have no paid plans.
BILLING_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_SOLO=
STRIPE_PRICE_ID_DESK=

# AIS Stream API Key (Real-time AIS Data)
AISSTREAM_API_KEY=

# Routing Provider (Server-side Route Estimation)
ROUTING_PROVIDER_API_KEY=

# Admin Overrides
ADMIN_UIDS=
ADMIN_EMAILS=

# AI model routing (server-side)
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_HEAVY=gemini-2.5-pro
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_HEAVY=gpt-4o
ANTHROPIC_MODEL_FAST=claude-3-5-haiku-latest
ANTHROPIC_MODEL_HEAVY=claude-sonnet-4-5

# Optional FreeLLMAPI/OpenAI-compatible experimental fallback.
# Keep disabled in production unless explicitly approved.
FREELLM_FALLBACK_ENABLED=false
FREELLM_API_BASE_URL=
FREELLM_API_KEY=
FREELLM_MODEL=auto
ALLOW_EXPERIMENTAL_LLM_FALLBACK=false

# Market intelligence provider abstraction.
# Production should point these at licensed provider adapter endpoints.
MARKET_SNAPSHOT_URL=
MARKET_DATA_API_KEY=
BUNKER_SNAPSHOT_URL=
BUNKER_DATA_API_KEY=

# For development/demo only. Reference values are ported from Doska and clearly marked SIMULATED.
MARKET_REFERENCE_MODE=false
ALLOW_SIMULATED_MARKET_DATA=false
