# Firebase Service Account JSON (optional fallback for server-side admin access if IAM/ADC is unavailable)
# Preferred production method: Cloud Run runtime service account with IAM roles (Cloud Datastore User).
# FIREBASE_SERVICE_ACCOUNT=

# Google Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Anthropic Claude API Key
ANTHROPIC_API_KEY=

# Canonical public application URL. Required in production for OAuth and Stripe redirects.
# Example: https://chartering.example.com
APP_BASE_URL=

# Number of trusted reverse-proxy hops in production (Cloud Run default: 1).
TRUST_PROXY_HOPS=1

# Maximum parsed JSON request body size (Express syntax, e.g. 1mb, 512kb).
JSON_BODY_LIMIT=1mb

# Encrypts Gmail refresh tokens and IMAP passwords at application level.
# Generate 32 random bytes and store the base64 value as a backend secret.
EMAIL_CREDENTIALS_ENCRYPTION_KEY=

# Shared secret required by the generic inbound email webhook.
# Send it in the x-email-webhook-secret header.
EMAIL_WEBHOOK_SECRET=

# Google OAuth Client ID (for Gmail integration)
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign-In Configuration
# Set to 'true' to enable the Apple Sign-In button on the registration screen.
# Ensure Firebase Authentication is configured with Apple Provider (Service ID, Team ID, Key ID, Private Key)
# and the app domain is authorized in both Firebase and Apple Developer Console.
VITE_APPLE_AUTH_ENABLED=false

# Stripe Settings
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AIS Stream API Key (Real-time AIS Data)
AISSTREAM_API_KEY=

# Routing Provider (Server-side Route Estimation)
ROUTING_PROVIDER_API_KEY=

# Admin Overrides
ADMIN_UIDS=
ADMIN_EMAILS=
